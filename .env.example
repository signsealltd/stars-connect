DATABASE_URL="mysql://stars_connect_user:change-me@127.0.0.1:3306/stars_connect"
NEXT_PUBLIC_APP_URL="https://app.starsconnect.co.uk"
APP_URL="https://app.starsconnect.co.uk"
APP_ENV="production"
NEXT_PUBLIC_APP_VERSION="1.0.0"
DOCUMENT_STORAGE_PATH="/var/lib/stars-connect/documents"
INVOICE_PREFIX="STARS"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_NAME="STARS Connect"
SMTP_FROM_EMAIL="reports@starsconnect.co.uk"
REPORT_JOB_SECRET="replace-with-at-least-32-random-bytes"
CRON_SECRET="replace-with-a-separate-random-secret-for-legacy-jobs"
SETTINGS_ENCRYPTION_KEY="replace-with-at-least-32-random-bytes-for-encrypted-settings"

# Administrator-created MariaDB backups (keep outside the public web root)
DATABASE_BACKUP_PATH="/var/backups/stars-connect"
MARIADB_DUMP_PATH="mariadb-dump"
APP_ENVIRONMENT="production"
