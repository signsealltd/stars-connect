  defaultRole  String?                   @db.VarChar(100)
  notes        String?                   @db.Text
  occurrences  StaffScheduleOccurrence[]

  @@unique([patternId, weekIndex, dayOfWeek, startTime, endTime])
  @@index([patternId, dayOfWeek])
}

model StaffScheduleOccurrence {
  id                    String                       @id @default(uuid()) @db.Char(36)
  organisationId        String                       @db.Char(36)
  organisation          Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  staffId               String                       @db.Char(36)
  staff                 StaffMember                  @relation(fields: [staffId], references: [id], onDelete: Restrict)
  patternId             String?                      @db.Char(36)
  pattern               StaffWorkingPattern?         @relation(fields: [patternId], references: [id], onDelete: SetNull)
  patternIntervalId     String?                      @db.Char(36)
  patternInterval       StaffWorkingPatternInterval? @relation(fields: [patternIntervalId], references: [id], onDelete: SetNull)
  date                  DateTime                     @db.Date
  startAt               DateTime
  endAt                 DateTime
  expectedClockInFrom   DateTime
  expectedClockInUntil  DateTime
  expectedClockOutFrom  DateTime
  expectedClockOutUntil DateTime
  premisesName          String?                      @db.VarChar(191)
  role                  String?                      @db.VarChar(100)
  status                ScheduleOccurrenceStatus     @default(SCHEDULED)
  manuallyModified      Boolean                      @default(false)
  generationKey         String                       @unique @db.VarChar(191)
  expectedAttendance    ExpectedStaffAttendance?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt

  @@index([organisationId, date, status])
  @@index([organisationId, staffId, startAt, endAt])
}

model StaffScheduleException {
  id                 String                 @id @default(uuid()) @db.Char(36)
  organisationId     String                 @db.Char(36)
  organisation       Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  staffId            String                 @db.Char(36)
  staff              StaffMember            @relation("ScheduleExceptionStaff", fields: [staffId], references: [id], onDelete: Restrict)
  replacementStaffId String?                @db.Char(36)
  replacementStaff   StaffMember?           @relation("ScheduleExceptionReplacement", fields: [replacementStaffId], references: [id], onDelete: SetNull)
  startDate          DateTime               @db.Date
  endDate            DateTime               @db.Date
  startTime          String?                @db.VarChar(5)
  endTime            String?                @db.VarChar(5)
  type               ScheduleExceptionType
  paid               Boolean                @default(false)
  approvalStatus     ScheduleApprovalStatus @default(PENDING)
  notes              String?                @db.Text
  createdById        String                 @db.Char(36)
  approvedById       String?                @db.Char(36)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([organisationId, staffId, startDate, endDate])
  @@index([organisationId, approvalStatus, type])
}

model Operation {
  id             String                @id @default(uuid()) @db.Char(36)
  organisationId String                @db.Char(36)
  organisation   Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  title          String                @db.VarChar(191)
  type           String                @db.VarChar(80)
  description    String?               @db.Text
  internalNotes  String?               @db.Text
  createdById    String                @db.Char(36)
  series         OperationSeries?
  occurrences    OperationOccurrence[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organisationId, type, createdAt])
}

model OperationSeries {
  id             String                @id @default(uuid()) @db.Char(36)
  organisationId String                @db.Char(36)
  organisation   Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  operationId    String                @unique @db.Char(36)
  operation      Operation             @relation(fields: [operationId], references: [id], onDelete: Cascade)
  recurrenceRule Json
  timezone       String                @default("Europe/London") @db.VarChar(80)
  active         Boolean               @default(true)
  occurrences    OperationOccurrence[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organisationId, active])
}

model OperationOccurrence {
  id                 String                       @id @default(uuid()) @db.Char(36)
  organisationId     String                       @db.Char(36)
  organisation       Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  operationId        String                       @db.Char(36)
  operation          Operation                    @relation(fields: [operationId], references: [id], onDelete: Cascade)
  seriesId           String?                      @db.Char(36)
  series             OperationSeries?             @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  startAt            DateTime
  endAt              DateTime
  allDay             Boolean                      @default(false)
  timezone           String                       @default("Europe/London") @db.VarChar(80)
  location           String?                      @db.VarChar(191)
  premisesName       String?                      @db.VarChar(191)
  roomName           String?                      @db.VarChar(120)
  requiredStaffCount Int                          @default(0)
  requiresCompliance Boolean                      @default(false)
  status             OperationStatus              @default(DRAFT)
  readiness          ReadinessLevel               @default(ACTION_REQUIRED)
  leadManagerId      String?                      @db.Char(36)
  leadStaffId        String?                      @db.Char(36)
  cancelledAt        DateTime?
  completedAt        DateTime?
  assignments        OperationStaffAssignment[]
  attendees          OperationAttendee[]
  readinessSnapshots OperationReadinessSnapshot[]
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([organisationId, startAt, endAt, status])
  @@index([organisationId, readiness, startAt])
}

model OperationStaffAssignment {
  id             String                    @id @default(uuid()) @db.Char(36)
  organisationId String                    @db.Char(36)
  organisation   Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  occurrenceId   String                    @db.Char(36)
  occurrence     OperationOccurrence       @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  staffId        String                    @db.Char(36)
  staff          StaffMember               @relation(fields: [staffId], references: [id], onDelete: Restrict)
  responsibility String?                   @db.VarChar(120)
  lead           Boolean                   @default(false)
  status         OperationAssignmentStatus @default(ASSIGNED)
  createdById    String                    @db.Char(36)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([occurrenceId, staffId])
  @@index([organisationId, staffId, status])
}

model OperationAttendee {
  id               String                  @id @default(uuid()) @db.Char(36)
  organisationId   String                  @db.Char(36)
  organisation     Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  occurrenceId     String                  @db.Char(36)
  occurrence       OperationOccurrence     @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  studentId        String                  @db.Char(36)
  student          Student                 @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status           OperationAttendeeStatus @default(PLANNED)
  transportMode    String?                 @db.VarChar(80)
  supportLevel     String?                 @db.VarChar(80)
  operationalNotes String?                 @db.VarChar(500)
  createdById      String                  @db.Char(36)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([occurrenceId, studentId])
  @@index([organisationId, studentId, status])
}

model ExpectedStaffAttendance {
  id                   String                    @id @default(uuid()) @db.Char(36)
  organisationId       String                    @db.Char(36)
  organisation         Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  staffId              String                    @db.Char(36)
  staff                StaffMember               @relation(fields: [staffId], references: [id], onDelete: Restrict)
  scheduleOccurrenceId String                    @unique @db.Char(36)
  scheduleOccurrence   StaffScheduleOccurrence   @relation(fields: [scheduleOccurrenceId], references: [id], onDelete: Cascade)
  date                 DateTime                  @db.Date
  expectedStartAt      DateTime
  expectedEndAt        DateTime
  state                ReconciliationState       @default(EXPECTED)
  reconciliation       AttendanceReconciliation?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([organisationId, date, state])
  @@index([organisationId, staffId, expectedStartAt])
}

model AttendanceReconciliation {
  id                   String                  @id @default(uuid()) @db.Char(36)
  organisationId       String                  @db.Char(36)
  organisation         Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  expectedAttendanceId String                  @unique @db.Char(36)
  expectedAttendance   ExpectedStaffAttendance @relation(fields: [expectedAttendanceId], references: [id], onDelete: Cascade)
  clockInEventId       String?                 @db.Char(36)
  clockOutEventId      String?                 @db.Char(36)
  state                ReconciliationState
  minutesLate          Int                     @default(0)
  minutesShort         Int                     @default(0)
  resolutionReason     String?                 @db.VarChar(500)
  resolvedById         String?                 @db.Char(36)
  resolvedAt           DateTime?
  calculatedAt         DateTime                @default(now())
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([organisationId, state, calculatedAt])
}

model OperationReadinessSnapshot {
  id             String              @id @default(uuid()) @db.Char(36)
  organisationId String              @db.Char(36)
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  occurrenceId   String              @db.Char(36)
  occurrence     OperationOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  level          ReadinessLevel
  blockers       Json
  warnings       Json
  calculatedById String?             @db.Char(36)
  calculatedAt   DateTime            @default(now())

  @@index([organisationId, occurrenceId, calculatedAt])
  @@index([organisationId, level, calculatedAt])
}
