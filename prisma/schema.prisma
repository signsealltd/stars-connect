generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRATOR
  DIRECTOR
  MANAGER
  RECEPTION
}

enum CredentialKind {
  PIN
  NFC
}

enum ClockEventType {
  CLOCK_IN
  CLOCK_OUT
}

enum AttendanceStatus {
  NOT_MARKED
  PRESENT
  ABSENT
  OFFSITE
  LATE
  CANCELLED
}

enum ScheduleOccurrenceStatus {
  SCHEDULED
  CHANGED
  LEAVE
  SICKNESS
  TRAINING
  CANCELLED
}

enum ScheduleExceptionType {
  ANNUAL_LEAVE
  SICKNESS
  TRAINING
  UNPAID_LEAVE
  TEMPORARY_HOURS
  OVERTIME
  ADDITIONAL_SHIFT
  SHIFT_SWAP
  NON_WORKING_DAY
  APPOINTMENT
  OTHER
}

enum ScheduleApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OperationStatus {
  DRAFT
  PLANNING
  AWAITING_APPROVAL
  STAFFING_INCOMPLETE
  COMPLIANCE_INCOMPLETE
  CHECKS_INCOMPLETE
  READY
  ACTIVE
  COMPLETED
  CANCELLED
  POST_OPERATION_REVIEW
}

enum OperationAssignmentStatus {
  ASSIGNED
  REPLACEMENT_REQUIRED
  REMOVED
}

enum OperationAttendeeStatus {
  PLANNED
  CONFIRMED
  WAITLISTED
  ABSENT
  PRESENT
  CANCELLED
}

enum ReadinessLevel {
  READY
  ACTION_REQUIRED
  BLOCKED
  CANCELLED
}

enum ReconciliationState {
  EXPECTED
  CLOCKED_IN
  LATE
  ABSENT_APPROVED
  MISSING_CLOCK_IN
  MISSING_CLOCK_OUT
  CLOCKED_OUT
  NOT_SCHEDULED
  REVIEW_REQUIRED
  RESOLVED
}

enum PhotoStatus {
  NOT_REQUIRED
  CAPTURED
  UNAVAILABLE
  PENDING_UPLOAD
}

enum CameraMode {
  DISABLED
  REQUIRED_ALL
  REQUIRED_SELECTED
  OPTIONAL
}

enum DeviceStatus {
  ACTIVE
  REVOKED
}

enum DeviceType {
  KIOSK_TABLET
  MANAGER_DESKTOP
}

enum RollCallStatus {
  ACTIVE
  CLOSED
}

enum SyncOperation {
  CLOCK_EVENT
  ATTENDANCE
  ROLL_CALL_ENTRY
  VISITOR_SIGN_IN
  VISITOR_SIGN_OUT
}

enum ConflictStatus {
  OPEN
  RESOLVED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum ComplianceRecordType {
  RISK_ASSESSMENT
  RAMS
  COSHH
  POLICY
}

enum ComplianceWorkflowStatus {
  DRAFT
  UNDER_REVIEW
  AWAITING_APPROVAL
  APPROVED
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum ComplianceApprovalDecision {
  APPROVED
  REJECTED
}

enum ComplianceActionStatus {
  OPEN
  IN_PROGRESS
  AWAITING_EVIDENCE
  AWAITING_VERIFICATION
  COMPLETED
  CANCELLED
}

model User {
  id                  String            @id @default(uuid()) @db.Char(36)
  email               String            @unique @db.VarChar(191)
  name                String            @db.VarChar(120)
  passwordHash        String
  role                Role
  active              Boolean           @default(true)
  permissionOverrides Json?
  organisationId      String?           @db.Char(36)
  organisation        Organisation?     @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  sessions            Session[]
  corrections         ClockCorrection[]
  visitorSignOuts     VisitorVisit[]    @relation("VisitorSignedOutBy")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([organisationId, active])
}

model Session {
  id         String   @id @default(uuid()) @db.Char(36)
  tokenHash  String   @unique @db.Char(64)
  userId     String   @db.Char(36)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model StaffMember {
  id                    String                     @id @default(uuid()) @db.Char(36)
  firstName             String                     @db.VarChar(80)
  lastName              String                     @db.VarChar(80)
  displayName           String                     @db.VarChar(120)
  email                 String                     @unique @db.VarChar(191)
  phone                 String?                    @db.VarChar(40)
  jobRole               String                     @db.VarChar(100)
  profilePhotoUrl       String?                    @db.Text
  contractedWeeklyHours Decimal?                   @db.Decimal(5, 2)
  hourlyRate            Decimal?                   @db.Decimal(10, 2)
  overtimeHourlyRate    Decimal?                   @db.Decimal(10, 2)
  payrollNumber         String?                    @unique @db.VarChar(80)
  active                Boolean                    @default(true)
  clockingEnabled       Boolean                    @default(true)
  sortOrder             Int                        @default(0)
  cameraRequired        Boolean                    @default(false)
  startDate             DateTime                   @db.Date
  endDate               DateTime?                  @db.Date
  notes                 String?                    @db.Text
  credentials           StaffCredential[]
  clockEvents           ClockEvent[]
  trainingRecords       StaffTrainingRecord[]
  workingPatterns       StaffWorkingPattern[]
  scheduleOccurrences   StaffScheduleOccurrence[]
  scheduleExceptions    StaffScheduleException[]   @relation("ScheduleExceptionStaff")
  replacementExceptions StaffScheduleException[]   @relation("ScheduleExceptionReplacement")
  operationAssignments  OperationStaffAssignment[]
  expectedAttendances   ExpectedStaffAttendance[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  archivedAt            DateTime?

  @@index([active, displayName])
}

model StaffTrainingRecord {
  id                   String      @id @default(uuid()) @db.Char(36)
  staffId              String      @db.Char(36)
  staff                StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  courseName           String      @db.VarChar(191)
  provider             String?     @db.VarChar(191)
  certificateReference String?     @db.VarChar(191)
  completedDate        DateTime    @db.Date
  expiryDate           DateTime?   @db.Date
  mandatory            Boolean     @default(false)
  notes                String?     @db.Text
  active               Boolean     @default(true)
  createdById          String      @db.Char(36)
  updatedById          String      @db.Char(36)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  @@index([staffId, active])
  @@index([expiryDate, active])
  @@index([courseName])
}

model StaffCredential {
  id         String         @id @default(uuid()) @db.Char(36)
  staffId    String         @db.Char(36)
  staff      StaffMember    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  kind       CredentialKind
  valueHash  String
  lookupHash String?        @db.Char(64)
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  revokedAt  DateTime?

  @@unique([kind, lookupHash])
  @@index([staffId, active])
}

model Student {
  id                               String              @id @default(uuid()) @db.Char(36)
  firstName                        String              @db.VarChar(80)
  lastName                         String              @db.VarChar(80)
  displayName                      String              @db.VarChar(120)
  profilePhotoUrl                  String?             @db.VarChar(500)
  expectedDays                     Json
  active                           Boolean             @default(true)
  sortOrder                        Int                 @default(0)
  startDate                        DateTime            @db.Date
  endDate                          DateTime?           @db.Date
  fundingCategory                  String?             @db.VarChar(100)
  fundingOrganisation              String?             @db.VarChar(191)
  internalReference                String?             @unique @db.VarChar(100)
  billingReference                 String?             @db.VarChar(100)
  emergencyContactName             String?             @db.VarChar(120)
  emergencyContactRelationship     String?             @db.VarChar(80)
  emergencyContactPhone            String?             @db.VarChar(40)
  emergencyContactAlternativePhone String?             @db.VarChar(40)
  emergencyContactEmail            String?             @db.VarChar(191)
  emergencyContactNotes            String?             @db.Text
  notes                            String?             @db.Text
  attendance                       StudentAttendance[]
  operationAttendances             OperationAttendee[]
  createdAt                        DateTime            @default(now())
  updatedAt                        DateTime            @updatedAt
  archivedAt                       DateTime?

  @@index([active, displayName])
}

model Device {
  id                String                   @id @default(uuid()) @db.Char(36)
  name              String                   @db.VarChar(120)
  tokenHash         String                   @unique @db.Char(64)
  status            DeviceStatus             @default(ACTIVE)
  deviceType        DeviceType               @default(KIOSK_TABLET)
  showBatteryStatus Boolean                  @default(true)
  appVersion        String?                  @db.VarChar(40)
  batteryLevel      Int?
  batteryCharging   Boolean?
  batteryUpdatedAt  DateTime?
  lastSeenAt        DateTime?
  lastSyncAt        DateTime?
  syncRequestedAt   DateTime?
  pendingEventCount Int                      @default(0)
  currentCursor     BigInt                   @default(0)
  tokenRotatedAt    DateTime?
  revokedAt         DateTime?
  isSeedData        Boolean                  @default(false)
  clockEvents       ClockEvent[]
  attendances       StudentAttendance[]
  syncEvents        SyncEvent[]
  visitorSignIns    VisitorVisit[]           @relation("VisitorSignInDevice")
  visitorSignOuts   VisitorVisit[]           @relation("VisitorSignOutDevice")
  provisioningCodes DeviceProvisioningCode[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
}

model DeviceProvisioningCode {
  id          String    @id @default(uuid()) @db.Char(36)
  deviceId    String    @db.Char(36)
  device      Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  codeHash    String    @unique @db.Char(64)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdById String    @db.Char(36)
  createdAt   DateTime  @default(now())

  @@index([deviceId, expiresAt])
}

model Visitor {
  id             String         @id @default(uuid()) @db.Char(36)
  fullName       String         @db.VarChar(120)
  normalizedName String         @db.VarChar(120)
  company        String?        @db.VarChar(191)
  mobile         String?        @db.VarChar(40)
  email          String?        @db.VarChar(191)
  visits         VisitorVisit[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  anonymizedAt   DateTime?

  @@index([normalizedName])
  @@index([company])
}

model VisitorReason {
  id        String         @id @default(uuid()) @db.Char(36)
  label     String         @unique @db.VarChar(100)
  sortOrder Int            @default(0)
  active    Boolean        @default(true)
  visits    VisitorVisit[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([active, sortOrder])
}

model VisitorRuleSet {
  id          String                  @id @default(uuid()) @db.Char(36)
  version     Int                     @unique
  title       String                  @db.VarChar(150)
  rulesText   String                  @db.Text
  active      Boolean                 @default(true)
  createdById String?                 @db.Char(36)
  acceptances VisitorRuleAcceptance[]
  createdAt   DateTime                @default(now())

  @@index([active, version])
}

model VisitorVisit {
  id                      String                 @id @db.Char(36)
  visitorId               String                 @db.Char(36)
  visitor                 Visitor                @relation(fields: [visitorId], references: [id])
  referenceCode           String                 @unique @db.VarChar(12)
  host                    String                 @db.VarChar(120)
  reasonId                String?                @db.Char(36)
  reason                  VisitorReason?         @relation(fields: [reasonId], references: [id], onDelete: SetNull)
  reasonLabel             String                 @db.VarChar(100)
  otherReason             String?                @db.VarChar(250)
  vehicleRegistration     String?                @db.VarChar(20)
  expectedDurationMinutes Int?
  signedInAt              DateTime
  signedOutAt             DateTime?
  signInDeviceId          String                 @db.Char(36)
  signInDevice            Device                 @relation("VisitorSignInDevice", fields: [signInDeviceId], references: [id])
  signOutDeviceId         String?                @db.Char(36)
  signOutDevice           Device?                @relation("VisitorSignOutDevice", fields: [signOutDeviceId], references: [id])
  signedOutByUserId       String?                @db.Char(36)
  signedOutByUser         User?                  @relation("VisitorSignedOutBy", fields: [signedOutByUserId], references: [id], onDelete: SetNull)
  signOutCorrectionReason String?                @db.Text
  emergencyIncluded       Boolean                @default(true)
  acceptance              VisitorRuleAcceptance?
  signature               VisitorSignature?
  archivedAt              DateTime?
  anonymizedAt            DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([signedInAt])
  @@index([signedOutAt])
  @@index([host])
  @@index([reasonId])
}

model VisitorRuleAcceptance {
  id                String         @id @default(uuid()) @db.Char(36)
  visitId           String         @unique @db.Char(36)
  visit             VisitorVisit   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  ruleSetId         String         @db.Char(36)
  ruleSet           VisitorRuleSet @relation(fields: [ruleSetId], references: [id])
  ruleVersion       Int
  acceptedRulesText String         @db.Text
  acceptedAt        DateTime
  createdAt         DateTime       @default(now())

  @@index([ruleSetId])
}

model VisitorSignature {
  id         String       @id @default(uuid()) @db.Char(36)
  visitId    String       @unique @db.Char(36)
  visit      VisitorVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  strokeData Json
  pointCount Int
  createdAt  DateTime     @default(now())
  expiresAt  DateTime
  deletedAt  DateTime?

  @@index([expiresAt, deletedAt])
}

model ClockEvent {
  id               String            @id @db.Char(36)
  staffId          String            @db.Char(36)
  staff            StaffMember       @relation(fields: [staffId], references: [id])
  deviceId         String            @db.Char(36)
  device           Device            @relation(fields: [deviceId], references: [id])
  type             ClockEventType
  deviceTimestamp  DateTime
  serverReceivedAt DateTime          @default(now())
  offlineRecorded  Boolean           @default(false)
  photoStatus      PhotoStatus       @default(NOT_REQUIRED)
  reviewRequired   Boolean           @default(false)
  transportDuty    Boolean           @default(false)
  photos           AttendancePhoto[]
  corrections      ClockCorrection[]
  createdAt        DateTime          @default(now())

  @@index([staffId, deviceTimestamp])
  @@index([serverReceivedAt])
}

model ClockCorrection {
  id            String     @id @default(uuid()) @db.Char(36)
  clockEventId  String     @db.Char(36)
  clockEvent    ClockEvent @relation(fields: [clockEventId], references: [id])
  managerId     String?    @db.Char(36)
  manager       User?      @relation(fields: [managerId], references: [id], onDelete: SetNull)
  reason        String     @db.Text
  originalValue Json
  newValue      Json
  createdAt     DateTime   @default(now())
}

model AttendancePhoto {
  id           String     @id @default(uuid()) @db.Char(36)
  clockEventId String     @db.Char(36)
  clockEvent   ClockEvent @relation(fields: [clockEventId], references: [id], onDelete: Cascade)
  storagePath  String     @db.VarChar(500)
  mimeType     String     @db.VarChar(80)
  sizeBytes    Int
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?

  @@index([expiresAt, deletedAt])
}

model StudentAttendance {
  id               String           @id @db.Char(36)
  studentId        String           @db.Char(36)
  student          Student          @relation(fields: [studentId], references: [id])
  deviceId         String           @db.Char(36)
  device           Device           @relation(fields: [deviceId], references: [id])
  date             DateTime         @db.Date
  status           AttendanceStatus @default(NOT_MARKED)
  arrivalTime      DateTime?
  departureTime    DateTime?
  note             String?          @db.Text
  version          Int              @default(1)
  deviceTimestamp  DateTime
  serverReceivedAt DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([studentId, date])
  @@index([date, status])
}

model EmergencyRollCall {
  id                   String                   @id @db.Char(36)
  status               RollCallStatus           @default(ACTIVE)
  startedByDeviceId    String                   @db.Char(36)
  attendanceSnapshotAt DateTime
  startedAt            DateTime
  closedAt             DateTime?
  closedByUserId       String?                  @db.Char(36)
  entries              EmergencyRollCallEntry[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
}

model EmergencyRollCallEntry {
  id              String            @id @db.Char(36)
  rollCallId      String            @db.Char(36)
  rollCall        EmergencyRollCall @relation(fields: [rollCallId], references: [id], onDelete: Cascade)
  personType      String            @db.VarChar(20)
  personId        String            @db.Char(36)
  displayName     String            @db.VarChar(120)
  accountedFor    Boolean           @default(false)
  accountedAt     DateTime?
  deviceTimestamp DateTime
  updatedAt       DateTime          @updatedAt

  @@unique([rollCallId, personType, personId])
}

model SyncEvent {
  sequence  BigInt        @id @default(autoincrement())
  eventId   String        @unique @db.Char(36)
  deviceId  String        @db.Char(36)
  device    Device        @relation(fields: [deviceId], references: [id])
  operation SyncOperation
  payload   Json
  createdAt DateTime      @default(now())

  @@index([deviceId, sequence])
}

model SyncConflict {
  id            String         @id @default(uuid()) @db.Char(36)
  entityType    String         @db.VarChar(50)
  entityId      String         @db.Char(36)
  deviceId      String         @db.Char(36)
  serverValue   Json
  incomingValue Json
  status        ConflictStatus @default(OPEN)
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())
}

model DailySummaryEmail {
  id                String      @id @default(uuid()) @db.Char(36)
  date              DateTime    @db.Date
  status            EmailStatus @default(PENDING)
  recipients        Json
  sentAt            DateTime?
  failureReason     String?     @db.Text
  retryCount        Int         @default(0)
  triggeredBy       String?     @db.VarChar(40)
  triggeredByUserId String?     @db.Char(36)
  attemptedAt       DateTime    @default(now())
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([date, status])
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Char(36)
  action      String   @db.VarChar(100)
  actorType   String   @db.VarChar(30)
  actorId     String?  @db.Char(36)
  entityType  String?  @db.VarChar(50)
  entityId    String?  @db.Char(36)
  beforeValue Json?
  afterValue  Json?
  ipAddress   String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(500)
  deviceId    String?  @db.Char(36)
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([action, entityType])
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedBy String?  @db.Char(36)
  updatedAt DateTime @updatedAt
}

model DocumentRecord {
  id                   String    @id @default(uuid()) @db.Char(36)
  documentNumber       String    @db.VarChar(80)
  documentType         String    @db.VarChar(40)
  periodStart          DateTime  @db.Date
  periodEnd            DateTime  @db.Date
  version              Int       @default(1)
  status               String    @default("GENERATED") @db.VarChar(30)
  createdById          String    @db.Char(36)
  reviewedById         String?   @db.Char(36)
  approvedById         String?   @db.Char(36)
  reviewedAt           DateTime?
  approvedAt           DateTime?
  generatedAt          DateTime?
  generationSource     String    @db.VarChar(40)
  storagePath          String    @db.VarChar(500)
  mimeType             String    @db.VarChar(100)
  fileSize             Int
  sha256Hash           String    @db.Char(64)
  revisionReason       String?   @db.Text
  supersededDocumentId String?   @db.Char(36)
  emailDeliveryStatus  String?   @db.VarChar(30)
  sourceType           String?   @db.VarChar(40)
  sourceId             String?   @db.Char(36)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([documentNumber, version])
  @@index([documentType, periodStart, periodEnd])
  @@index([sourceType, sourceId])
}

model PayrollPeriod {
  id                 String              @id @default(uuid()) @db.Char(36)
  periodStart        DateTime            @db.Date
  periodEnd          DateTime            @db.Date
  payDate            DateTime?           @db.Date
  status             String              @default("DRAFT") @db.VarChar(30)
  version            Int                 @default(1)
  notes              String?             @db.Text
  revisionReason     String?             @db.Text
  supersedesPeriodId String?             @db.Char(36)
  createdById        String              @db.Char(36)
  reviewedById       String?             @db.Char(36)
  approvedById       String?             @db.Char(36)
  reviewedAt         DateTime?
  approvedAt         DateTime?
  lockedAt           DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  entries            PayrollEntry[]
  adjustments        PayrollAdjustment[]

  @@unique([periodStart, periodEnd, version])
  @@index([status, periodStart])
}

model PayrollEntry {
  id                  String        @id @default(uuid()) @db.Char(36)
  payrollPeriodId     String        @db.Char(36)
  payrollPeriod       PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  staffId             String        @db.Char(36)
  staffName           String        @db.VarChar(120)
  payrollNumber       String?       @db.VarChar(80)
  hourlyRate          Decimal?      @db.Decimal(10, 2)
  overtimeHourlyRate  Decimal?      @db.Decimal(10, 2)
  grossPay            Decimal?      @db.Decimal(12, 2)
  ordinaryMinutes     Int           @default(0)
  overtimeMinutes     Int           @default(0)
  holidayMinutes      Int           @default(0)
  sicknessMinutes     Int           @default(0)
  trainingMinutes     Int           @default(0)
  unpaidMinutes       Int           @default(0)
  adjustmentMinutes   Int           @default(0)
  originalMinutes     Int           @default(0)
  transportMinutes    Int           @default(0)
  preRoundedMinutes   Int           @default(0)
  roundingMinutes     Int           @default(0)
  totalPayableMinutes Int           @default(0)
  exceptionCount      Int           @default(0)
  exceptionStatus     String        @default("CLEAR") @db.VarChar(30)
  reviewedAt          DateTime?
  reviewedById        String?       @db.Char(36)
  sourceSnapshot      Json
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@unique([payrollPeriodId, staffId])
  @@index([staffId])
}

model PayrollAdjustment {
  id              String        @id @default(uuid()) @db.Char(36)
  payrollPeriodId String        @db.Char(36)
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  staffId         String        @db.Char(36)
  date            DateTime      @db.Date
  category        String        @db.VarChar(30)
  minutes         Int
  paid            Boolean       @default(true)
  reason          String        @db.Text
  createdById     String        @db.Char(36)
  createdAt       DateTime      @default(now())

  @@index([payrollPeriodId, staffId, date])
}

model BillingProfile {
  id                  String       @id @default(uuid()) @db.Char(36)
  studentId           String       @db.Char(36)
  payerType           String       @db.VarChar(40)
  payerName           String       @db.VarChar(191)
  billingAddress      String       @db.Text
  billingEmail        String?      @db.VarChar(191)
  contactTelephone    String?      @db.VarChar(40)
  fundingOrganisation String?      @db.VarChar(191)
  purchaseOrderNumber String?      @db.VarChar(100)
  fundingReference    String?      @db.VarChar(100)
  billingReference    String?      @db.VarChar(100)
  invoiceFrequency    String       @default("MONTHLY") @db.VarChar(30)
  paymentTermsDays    Int          @default(30)
  currency            String       @default("GBP") @db.Char(3)
  vatTreatment        String       @default("OUTSIDE_SCOPE") @db.VarChar(30)
  vatRate             Decimal      @default(0) @db.Decimal(5, 2)
  exemptionReason     String?      @db.Text
  consolidatedByPayer Boolean      @default(false)
  activeFrom          DateTime     @db.Date
  activeTo            DateTime?    @db.Date
  financeNotes        String?      @db.Text
  createdById         String       @db.Char(36)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  chargeRules         ChargeRule[]

  @@index([studentId, activeFrom, activeTo])
}

model ChargeRule {
  id                   String         @id @default(uuid()) @db.Char(36)
  billingProfileId     String         @db.Char(36)
  billingProfile       BillingProfile @relation(fields: [billingProfileId], references: [id], onDelete: Cascade)
  chargeType           String         @db.VarChar(40)
  description          String         @db.VarChar(191)
  unitType             String         @db.VarChar(30)
